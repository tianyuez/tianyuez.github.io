---
layout: base.njk
permalink: /
bodyClass: home-page
---
<section class="hero hero-compact" aria-labelledby="hero-name">
  <div class="hero-grid shell">
    <div class="hero-copy reveal">
      <p class="eyebrow">EMBODIED AI · PHYSICAL AI</p>
      <h1 id="hero-name">{{ site.name }}<small>{{ site.chineseName }}</small></h1>
      <p class="hero-role" data-translate>{{ site.title }}</p>
      <p class="hero-bio" data-translate>{{ site.bio }}</p>
      <div class="hero-actions">
        {% for link in site.links %}<a href="{% if link.url.startsWith('/') %}{{ link.url | withBase }}{% else %}{{ link.url }}{% endif %}"{% if link.url.startsWith('http') %} target="_blank" rel="noopener"{% endif %}>{{ link.label }} ↗</a>{% endfor %}
      </div>
    </div>
    <div class="portrait-wrap reveal"><div class="portrait-index">SUSTECH / SHENZHEN</div><img src="{{ site.photo | withBase }}" alt="Portrait of {{ site.name }}" width="900" height="1055"><div class="portrait-caption"><span>{{ site.institution }}</span><span>{{ site.location }}</span></div></div>
    <aside class="hero-meta reveal" aria-label="Contact information"><div><span>Affiliation</span><strong>{{ site.school }}</strong></div><div><span>Office</span><strong>{{ site.office }}</strong></div><div><span>Contact</span><a href="mailto:{{ site.email }}">{{ site.email }}</a></div></aside>
  </div>
</section>
<section class="keyword-strip"><div class="shell"><span class="section-number" data-i18n="Research">RESEARCH</span><div>{% for item in site.research %}<span data-translate>{{ item }}</span>{% endfor %}</div></div></section>
<section class="section shell" id="news"><header class="section-head reveal"><p class="section-number">01 / <span data-i18n="News">NEWS</span></p><h2 data-i18n="Recent news">Recent news</h2></header><div class="home-columns"><div class="news-list">{% for item in site.news %}<a class="news-item reveal" href="{{ item.url }}" target="_blank" rel="noopener"><time>{{ item.date }}</time><p><span data-translate>{{ item.text }}</span> ↗</p></a>{% endfor %}</div><aside class="home-aside reveal"><p class="section-number" data-i18n="Research focus">RESEARCH FOCUS</p><p class="aside-copy" data-i18n="Embodied and physical AI systems for real-world environments.">Embodied and physical AI systems for real-world environments.</p><a class="text-link" href="{{ '/about/' | withBase }}"><span data-i18n="About my research">About my research</span> ↗</a></aside></div></section>
<section class="section section-ink" id="featured"><div class="shell"><header class="section-head light reveal"><p class="section-number">02 / <span data-i18n="Selected work">SELECTED WORK</span></p><h2 data-i18n="Selected publications">Selected publications</h2></header><div class="featured-list">{% for pub in site.selectedPublications %}<a class="publication-item reveal" href="{{ (pub.title ~ ' ' ~ pub.authors) | scholarUrl }}" target="_blank" rel="noopener"><span class="pub-year">{{ pub.year }}</span><span class="pub-main"><h3>{{ pub.title }}</h3><p>{{ pub.authors }}</p><strong>{{ pub.venue }}</strong><span class="author-role" data-i18n="{{ pub.role }}">{{ pub.role }}</span></span><span class="pub-tag">{{ pub.tag }}</span><span class="pub-arrow">↗</span></a>{% endfor %}</div><a class="load-more link-button" href="{{ '/publications/' | withBase }}">Browse all {{ collections.publications | length }} publications <span>↗</span></a></div></section>
<section class="contact-section"><div class="shell contact-inner reveal"><p class="section-number" data-i18n="Open positions">OPEN POSITIONS</p><h2 data-i18n="Join the research group">Join the research group</h2><p data-translate>{{ site.recruitment }}</p><a class="contact-link" href="mailto:{{ site.email }}"><span data-i18n="Contact">Contact</span> <span>↗</span></a></div></section>
