---
layout: base.njk
title: About
permalink: /about/
---
<section class="page-hero shell"><p class="section-number"><span data-i18n="About">ABOUT</span> / <span data-i18n="Profile">PROFILE</span></p><h1 data-i18n="Research experience">Context for the work.</h1><p class="page-intro" data-translate>{{ site.bio }}</p></section>
<section class="section shell"><div class="profile-layout"><div class="profile-nav"><a class="profile-tab active" href="#experience" data-i18n="Experience">Experience</a><a class="profile-tab" href="#education" data-i18n="Education">Education</a><a class="profile-tab" href="#grants" data-i18n="Grants & talks">Grants & talks</a><a class="profile-tab" href="#service" data-i18n="Service">Service</a></div><div class="profile-panels"><div id="experience"><h2 class="compact-heading" data-i18n="Experience">Experience</h2>{% for item in site.experience %}<article class="timeline-item"><time>{{ item.period }}</time><div><h3 data-translate>{{ item.role }}</h3><p><span data-translate>{{ item.place }}</span> · <span data-translate>{{ item.location }}</span></p></div></article>{% endfor %}</div><div id="education"><h2 class="compact-heading" data-i18n="Education">Education</h2>{% for item in site.education %}<article class="timeline-item"><time>{{ item.period }}</time><div><h3 data-translate>{{ item.degree }}</h3><p><span data-translate>{{ item.place }}</span> · <span data-translate>{{ item.detail }}</span></p></div></article>{% endfor %}</div><div id="grants"><h2 class="compact-heading" data-i18n="Grants & talks">Grants & talks</h2><ul class="simple-list">{% for item in site.grants %}<li data-translate>{{ item }}</li>{% endfor %}{% for item in site.talks %}<li data-translate>{{ item }}</li>{% endfor %}</ul></div><div id="service"><h2 class="compact-heading" data-i18n="Professional service">Professional service</h2>{% for item in site.service %}<article class="timeline-item"><time data-translate>{{ item.label }}</time><div><p data-translate>{{ item.text }}</p></div></article>{% endfor %}</div></div></div></section>
<section class="split-band"><div class="shell split-grid"><div><header class="mini-head"><p class="section-number">RECOGNITION</p><h2>Honors</h2></header>{% for item in site.awards %}<article class="award-item"><time>{{ item.year }}</time><p><strong>{{ item.title }}</strong><span>{{ item.detail }}</span></p></article>{% endfor %}</div><div><header class="mini-head"><p class="section-number">TEACHING</p><h2>Courses</h2></header>{% for item in site.teaching %}<article class="award-item"><time>{{ item.period }}</time><p><strong>{{ item.course }} <small>{{ item.code }}</small></strong><span>{{ item.role }}</span></p></article>{% endfor %}</div></div></section>
