<section class="page-hero shell"><p class="section-number"><span data-i18n="Publications">PUBLICATIONS</span> / 2019—2026</p><h1 data-i18n="Publication archive">Research archive.</h1><p class="page-intro" data-i18n="A searchable record of work in embodied AI, physical AI, mobile systems, and sensing-system security.">A searchable record of work in embodied AI, physical AI, mobile systems, and sensing-system security.</p></section>
<section class="section section-ink"><div class="shell"><div class="pub-tools"><div class="filter-group" id="publication-filters"><button type="button" class="active" data-filter="All">All</button><button type="button" data-filter="Journal">Journal</button><button type="button" data-filter="Conference">Conference</button><button type="button" data-filter="Workshop">Workshop</button></div><label class="search-box"><span>SEARCH</span><input id="publication-search" type="search" placeholder="Title, venue, topic…" autocomplete="off"></label></div><div class="publication-list" id="publication-list">{% for pub in collections.publications %}<article class="publication-item" data-type="{{ pub.data.type }}" data-search="{{ pub.data.title }} {{ pub.data.authors }} {{ pub.data.venue }} {{ pub.data.tag }}"><span class="pub-year">{{ pub.data.year }}</span><span class="pub-main"><h3>{{ pub.data.title }}</h3><p>{{ pub.data.authors }}</p><strong>{{ pub.data.venue }}</strong><span class="pub-links"><a href="{{ pub.data.scholar or ((pub.data.title ~ ' ' ~ pub.data.authors) | scholarUrl) }}" target="_blank" rel="noopener">Google Scholar ↗</a></span>{% if pub.data.role and pub.data.role != "Co-author" %}<span class="author-role" data-i18n="{{ pub.data.role }}">{{ pub.data.role }}</span>{% endif %}</span><span class="pub-tag">{{ pub.data.tag }}</span></article>{% else %}<div class="publication-empty"><p data-i18n="The publication archive is temporarily unavailable.">The publication archive is temporarily unavailable.</p><a href="https://scholar.google.com/citations?user=A-YvDJgAAAAJ&hl=en" target="_blank" rel="noopener">Google Scholar ↗</a></div>{% endfor %}</div></div></section>
